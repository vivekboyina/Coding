#include <bits/stdc++.h>
using namespace std;
int main() {
    int t;
    cin >> t;
    while(t--)
    {
        int x,y,p;
        cin >> x >> y >> p;
        int ans = 0;
        while(x*y < p)
        {
            if((x + 1)*y > (y + 1)*x) x+=1;
            else y+=1;
            ans+=1;
        }
        cout << ans << endl;
    }
}