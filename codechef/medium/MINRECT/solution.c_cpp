#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin >> t;
	while(t--)
	{
	    int n,m;
	    cin >> n >> m;
	    vector<string>arr(n);
	    for(int i = 0; i < n; i++) cin >> arr[i];
	    int r1 = -1,r2 = -1;
	    int l = INT_MAX,r = INT_MIN;
	    for(int i = 0; i < n; i++)
	    {
	        for(int j = 0; j < m; j++)
	        {
	            if(arr[i][j] == '1')
	            {
	                if(r1 == -1) r1 = i + 1;
	                else if(r1 <= i) r2 = max(i + 1,r2);
	                l = min(l,j + 1);
	                r = max(r,j + 1);
	            }
	        }
	    }
	    int len = 1,brd = 1;
	    len = max(r2 - r1 + 1,len);
        brd = max(r - l + 1,brd);
	    cout << len*brd << endl;
	}
}
