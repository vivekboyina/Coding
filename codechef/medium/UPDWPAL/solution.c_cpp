#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

void solve() {
    int n;
    cin >> n;
    vector<long long> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    long long L = 0;
    long long R = 2e9 + 7;

    for (int i = 0; i < n / 2; i++) {
        long long u = a[i];
        long long v = a[n - 1 - i];
        if (u > v) swap(u, v);

        long long diff = v - u;

        if (diff == 0) {
            continue;
        } else if (diff == 1) {
            L = max(L, u);
            R = min(R, u);
        } else if (diff == 2) {
            L = max(L, u);
            R = min(R, v - 1);
        } else {
            cout << "NO\n";
            return;
        }
    }

    if (L <= R) {
        cout << "YES\n";
    } else {
        cout << "NO\n";
    }
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}