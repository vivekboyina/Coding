#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
	int t;
	cin >> t;
	while(t--)
	{
	    long long n;
	    cin >> n;
	    vector<long long>cc(n);
	    for(long long i = 0; i < n; i++) cin >> cc[i];
	    sort(cc.begin(),cc.end(),greater<int>());
	    long long k;
	    long long tsum = 0;
	    for(long long i : cc) tsum+=i;
	    long long csum = 0;
	    long long ans = 0;
	    for(int i = 0; i < n; i++)
	    {
	        csum+=cc[i];
	        k = n - i - 1;
	        ans = max(ans,(csum*k + (tsum - csum)*(i + 1)));
	    }
	    cout << ans << endl;
	}
}
