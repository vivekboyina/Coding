#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin >> t;
	while(t--)
	{
	    int x1,y1,x2,y2;
	    cin >> x1 >> y1 >> x2 >> y2;
	    int a = x1 + y1;
	    int b = x2 + y2;
	    int c = x1 - y1;
	    int d = x2 - y2;
	    if(a % 2 != b % 2) cout << -1 << endl;
	    else if(a == b || c == d) cout << 1 << endl;
	    else cout << 2 << endl;
	}
}
