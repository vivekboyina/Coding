#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin >> t;
	while(t--)
	{
	    int n;
	    cin >> n;
	    vector<int>cc(n);
	    for(int i = 0; i < n; i++) cin >> cc[i];
	    int sum = 0,mi = LLONG_MAX;
	    bool pp = true,dd = false;
	    for(int i = 0; i < n; i++)
	    {
	        sum+=cc[i];
	        mi = min(mi,cc[i]);
	        if(sum < 0)
	        {
	            if(dd) pp = false;
	            else
	            {
	                sum-=mi;
	                dd = true;
	            }
	        }
	    }
	    if(pp) cout << "yes\n";
	    else cout << "no\n";
	}
}
