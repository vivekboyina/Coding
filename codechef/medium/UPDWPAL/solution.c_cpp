#include <bits/stdc++.h>
using namespace std;
int main() {
    int t;
    cin >> t;
    while(t--)
    {
        int n;
        cin >> n;
        vector<int>cc(n);
        for(int i = 0; i < n; i++) cin >> cc[i];
        int i = 0;
        int j = n - 1;
        bool ans = true;
        int o = -1,s = -1;
        int diff;
        while(i <= j)
        {
            diff = abs(cc[i] - cc[j]);
            if(diff != 0 || diff != 2)
            {
                ans = false;
                break;
            }
            if(diff == 2)
            {
                if(o == -1 && s == -1)
                {
                    o = min(cc[i],cc[j]);
                    s = o + 1;
                }
                else
                {
                    if(cc[i] > o) cc[i]-=1;
                    else cc
                }
            }
            i++;
            j--;
        }
        if(ans) cout << "YES" << endl;
        else cout << "NO" << endl;
    }
}