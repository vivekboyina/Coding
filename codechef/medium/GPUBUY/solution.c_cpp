#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin >> t;
	while(t--)
	{
	    int x,y,z;
	    cin >> x >> y >> z;
	    int st = 0;
	    if(y >= z)
	    {
	        cout << -1 << endl;
	        continue;
	    }
	    int ans = 0;
	    do{
	        st = st + z;
	        x = x + y;
	        ans+=1;
	    }while(st >= x);
	    cout << ans << endl;
	}
}
